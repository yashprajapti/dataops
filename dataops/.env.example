# ---- Supabase (real accounts + saved workspaces) --------------------------------
# Supabase → Project Settings → API. Leave empty to run in browser-only demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Google Gemini (optional, generative AI answers) ----------------------------
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
